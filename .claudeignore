# Paths hidden from AI coding assistants.
# gitignore-style patterns. Keep .claudeignore / .cursorignore / .llmignore identical.

# --- Secrets (never expose to a model) ---
.env
.env.*
*.env
.dev.vars

# --- Dependencies & build output ---
node_modules/
dist/
dist-ssr/
.output/
.nitro/
.vinxi/
.tanstack/
.wrangler/

# --- Machine-generated, large, no signal ---
bun.lock

# --- VCS & editor state ---
.git/
.history/
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Agent & platform scratch ---
.claude-trace
.lovable/
# --- Content parked for LLMs to skip ---
# Tracked in git, hidden from assistants. Holds the 243KB raw transcript;
# the specs derived from it (docs/human_only, docs/llm_generated) stay visible.
llm_ignore/

# --- Static assets (no readable content) ---
public/
