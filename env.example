# TGS environment template.
#
# Copy to `.env` (which is gitignored) and fill in the values:
#   cp env.example .env
#
# NOTE: this file is named `env.example`, not `.env.example`, because
# .gitignore ignores `.env.*` — a dotted example file would never be committed.

# --- Claude / Anthropic -----------------------------------------------------
# Required for the left AI Assistant pane and the Validator's LLM rubric run.
# Read server-side only (src/server/claude.ts); it is never sent to the browser.
# Without it both features degrade gracefully with a "not configured" message.
ANTHROPIC_API_KEY=

# Model used by the assistant and the LLM validator.
# Configurable app setting; `claude-opus-5` is the default (spec reconciliation #7).
TGS_CLAUDE_MODEL=claude-opus-5

# --- Local execution sandbox ------------------------------------------------
# The local Deno proxy the Runner fires HTTP tests at (zero-trust parity with STS).
# VITE_-prefixed so it reaches the browser, which is what makes the HTTP calls.
# The Runner tab's URL field overrides this at runtime.
VITE_TGS_RUNNER_URL=http://localhost:8080

# The port the sandbox itself binds to (read by local-deno-server/server.ts).
TGS_RUNNER_PORT=8080
